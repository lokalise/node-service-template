{
  "name": "node-service-template",
  "version": "2.0.0",
  "private": true,
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=24.16.0",
      "onFail": "error"
    },
    "packageManager": {
      "name": "pnpm",
      "version": "11.25.0",
      "onFail": "error"
    }
  },
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "test:ci": "turbo run test:ci --concurrency=1",
    "lint": "biome check *.json *.jsonc && turbo run lint",
    "lint:fix": "biome check --write *.json *.jsonc && turbo run lint:fix",
    "docker:start:dev": "pnpm --filter @node-service-template/service run docker:start:dev",
    "docker:stop:dev": "pnpm --filter @node-service-template/service run docker:stop:dev",
    "db:apply-migrations": "pnpm --filter @node-service-template/service run db:apply-migrations"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@lokalise/biome-config": "^4.0.0",
    "turbo": "^2.11.9"
  },
  "optionalDependencies": {
    "@biomejs/cli-darwin-arm64": "^2.5.15",
    "@biomejs/cli-linux-arm64": "^2.5.15",
    "@biomejs/cli-linux-x64": "^2.5.15",
    "@biomejs/cli-win32-x64": "^2.5.15"
  }
}
