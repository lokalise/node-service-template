{
  "name": "node-service-template",
  "version": "1.27.0",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=24.16.0",
      "onFail": "error"
    },
    "packageManager": {
      "name": "pnpm",
      "version": "11.25.0",
      "onFail": "error"
    }
  },
  "type": "module",
  "scripts": {
    "build": "pnpm --filter @node-service-template/api-contracts run build && tsc -p tsconfig.build.json",
    "build:service": "tsc -p tsconfig.build.json",
    "build:contracts": "pnpm --filter @node-service-template/api-contracts run build",
    "test": "vitest",
    "test:migrate": "node --env-file=.env.test --env-file-if-exists=.env.test.local ./node_modules/drizzle-kit/bin.cjs migrate --config=./src/db/drizzle.config.ts",
    "test:coverage": "node --run test -- --coverage",
    "test:ci": "node --run test:migrate && node --run test:coverage",
    "lint": "biome check . && tsc && pnpm --filter \"./packages/*\" run lint && pnpm run docs:validate",
    "lint:fix": "biome check --write . && pnpm --filter \"./packages/*\" run lint:fix",
    "start:dev": "node --run build:contracts && node --env-file=.env.development --env-file-if-exists=.env.development.local src/server.ts",
    "start:dev:watch": "node --run build:contracts && node --watch --env-file=.env.development --env-file-if-exists=.env.development.local src/server.ts",
    "start:prod": "node --run build && cross-env NODE_ENV=production node --env-file-if-exists=.env.development --env-file-if-exists=.env.development.local dist/server.js",
    "start:prod:opentelemetry": "node --run build && cross-env NODE_ENV=production node --import=@opentelemetry/instrumentation/hook.mjs --env-file-if-exists=.env.development --env-file-if-exists=.env.development.local dist/server.js",
    "free-ports": "pnpm dlx cross-port-killer 3000",
    "docker:start:dev": "docker compose up -d --quiet-pull --wait",
    "docker:stop:dev": "docker compose down",
    "db:generate-migrations": "node --env-file=.env.development --env-file-if-exists=.env.development.local ./node_modules/drizzle-kit/bin.cjs generate --config=./src/db/drizzle.config.ts",
    "db:apply-migrations": "node --env-file=.env.development --env-file-if-exists=.env.development.local ./node_modules/drizzle-kit/bin.cjs migrate --config=./src/db/drizzle.config.ts",
    "db:drop-migrations": "node --env-file=.env.development --env-file-if-exists=.env.development.local ./node_modules/drizzle-kit/bin.cjs drop --config=./src/db/drizzle.config.ts",
    "spec:generate": "node --env-file=.env.development --env-file-if-exists=.env.development.local scripts/generateOpenApi.ts",
    "docs:generate": "envase generate ./src/infrastructure/config.ts -o ./docs/environment-variables.md",
    "docs:validate": "envase validate ./src/infrastructure/config.ts ./docs/environment-variables.md",
    "prepublishOnly": "node --run build",
    "jwt:generate": "node --env-file=.env.development --env-file-if-exists=.env.development.local scripts/generateJwt.ts",
    "cmd:getUserImportJobs": "node --env-file=.env.development --env-file-if-exists=.env.development.local scripts/cmd/getUserImportJobs.ts",
    "perf:up": "node perf/runPerfStack.ts up",
    "perf:run": "node perf/runPerfStack.ts run",
    "perf:run:smoke": "node perf/runPerfStack.ts run -e TEST_TYPE=smoke",
    "perf:k6": "node perf/runPerfStack.ts k6",
    "perf:k6:docker": "node perf/runPerfStack.ts k6 --k6=docker",
    "perf:down": "node perf/runPerfStack.ts down",
    "perf:probe": "node perf/probe/server.ts",
    "perf:analyze": "node perf/runPerfStack.ts analyze"
  },
  "dependencies": {
    "@aws-sdk/client-sns": "^3.1152.0",
    "@aws-sdk/client-sqs": "^3.1152.0",
    "@aws-sdk/client-sts": "^3.1152.0",
    "@aws-sdk/credential-providers": "^3.1152.0",
    "@fastify/auth": "^5.1.2",
    "@fastify/awilix": "^8.3.1",
    "@fastify/cors": "^11.3.1",
    "@fastify/helmet": "^13.2.0",
    "@fastify/jwt": "^10.2.4",
    "@fastify/otel": "0.21.2",
    "@fastify/schedule": "^7.0.1",
    "@fastify/swagger": "^9.9.2",
    "@lokalise/api-contracts": "^9.0.1",
    "@lokalise/aws-config": "^10.0.0",
    "@lokalise/backend-http-client": "^13.0.0",
    "@lokalise/background-jobs-common": "^17.0.1",
    "@lokalise/config": "^1.0.1",
    "@lokalise/errors": "^2.1.0",
    "@lokalise/fastify-api-contracts": "^8.0.0",
    "@lokalise/fastify-extras": "^36.0.1",
    "@lokalise/healthcheck-utils": "^8.0.0",
    "@lokalise/node-core": "^14.11.0",
    "@lokalise/opentelemetry-fastify-bootstrap": "^4.1.2",
    "@lokalise/pyroscope-profiling": "^1.1.1",
    "@lokalise/universal-ts-utils": "^4.12.0",
    "@lokalise/zod-extras": "^3.0.2",
    "@message-queue-toolkit/amqp": "^25.0.1",
    "@message-queue-toolkit/core": "^27.2.0",
    "@message-queue-toolkit/metrics": "^6.0.0",
    "@message-queue-toolkit/schemas": "^8.1.0",
    "@message-queue-toolkit/sns": "^27.2.0",
    "@message-queue-toolkit/sqs": "^27.2.0",
    "@node-service-template/api-contracts": "workspace:*",
    "@opentelemetry/auto-instrumentations-node": "0.81.0",
    "@opentelemetry/exporter-trace-otlp-grpc": "0.223.0",
    "@opentelemetry/instrumentation": "^0.223.0",
    "@prometheus-io/client": "^0.16.1",
    "amqplib": "^2.2.0",
    "awilix": "^13.0.5",
    "awilix-manager": "^7.1.0",
    "bullmq": "^6.3.15",
    "drizzle-kit": "1.0.0-rc.5-5935859",
    "drizzle-orm": "1.0.0-rc.5-5935859",
    "envase": "^2.1.0",
    "fastify": "^5.12.7",
    "fastify-graceful-shutdown": "^5.0.0",
    "fastify-metrics": "^14.1.0",
    "fastify-no-icon": "^7.0.0",
    "fastify-plugin": "^6.0.1",
    "fastify-type-provider-zod": "^7.0.0",
    "ioredis": "^6.0.0",
    "layered-loader": "^17.0.0",
    "opinionated-machine": "^13.0.0",
    "pino": "^10.4.0",
    "pino-pretty": "^13.2.0",
    "postgres": "^3.4.9",
    "redis-semaphore": "^6.0.0",
    "toad-scheduler": "^4.2.0",
    "undici": "^8.12.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@amplitude/analytics-types": "^2.11.1",
    "@biomejs/biome": "2.5.15",
    "@lokalise/biome-config": "^4.0.0",
    "@lokalise/load-testing-utils": "^2.0.0",
    "@lokalise/tsconfig": "^5.0.0",
    "@lokalise/universal-testing-utils": "^5.0.0",
    "@opentelemetry/sdk-trace-base": "^2.12.0",
    "@readme/openapi-parser": "^9.1.0",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.4",
    "cross-env": "^10.1.0",
    "fast-jwt": "^6.3.4",
    "fauxqs": "^2.12.2",
    "mockttp": "^4.6.4",
    "typescript": "7.0.2",
    "vitest": "^5.0.4",
    "yaml": "^2.9.1"
  },
  "optionalDependencies": {
    "@biomejs/cli-darwin-arm64": "^2.5.15",
    "@biomejs/cli-linux-arm64": "^2.5.15",
    "@biomejs/cli-linux-x64": "^2.5.15",
    "@biomejs/cli-win32-x64": "^2.5.15",
    "@esbuild/darwin-arm64": "^0.28.2",
    "@esbuild/linux-arm64": "^0.28.2",
    "@esbuild/linux-x64": "^0.28.2",
    "@esbuild/win32-x64": "^0.28.2"
  }
}
