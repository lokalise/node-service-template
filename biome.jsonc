{
    "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
    "root": true,
    "extends": [
        "./node_modules/@lokalise/biome-config/configs/biome-base.jsonc",
        "./node_modules/@lokalise/biome-config/configs/biome-esm.jsonc"
    ],
    "files": {
        "includes": [
            "**",
            "!**/node_modules",
            "!**/dist",
            "!**/coverage",
            "!packages",
            // Load-test output and the key pair the runner generates, all gitignored
            "!perf/.auth",
            "!perf/k6/k6-summary.json"
        ]
    },
    "linter": {
        // add overrides here if necessary
        "rules": {}
    },
    "overrides": [
        {
            // The load-test runner and probe are CLIs: the terminal is their only output.
            "includes": ["perf/**"],
            "linter": { "rules": { "suspicious": { "noConsole": "off" } } }
        },
        {
            // Globals the k6 runtime provides to a test script.
            "includes": ["perf/k6/**"],
            "javascript": { "globals": ["__ENV"] }
        }
    ]
}
