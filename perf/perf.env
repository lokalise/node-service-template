# The service's configuration for a local load-test run. Read by perf/runPerfStack.ts and
# handed to every process it spawns (the migration, the probe, the service), never loaded by
# the service on its own.
#
# A variable already exported in your shell wins over this file, as with `node --env-file`.
# The PERF_*_PORT variables move a container and the matching address below together.
#
# JWT_PUBLIC_KEY is absent on purpose: the runner generates a key pair on `up` (kept in
# perf/.auth/) and passes the public half to the service and a signed token to k6.

# app
NODE_ENV=development
APP_ENV=development
APP_VERSION=perf
GIT_COMMIT_SHA=perf
APP_PORT=3100
APP_BIND_ADDRESS=127.0.0.1
BASE_URL=http://localhost:3100
LOG_LEVEL=warn
# The resource report reads prom-client's default metrics from :9080/metrics.
METRICS_ENABLED=true
DATABASE_URL=postgresql://serviceuser:pass@localhost:5452/service_db_perf?application_name=node-service-template
SAMPLE_FAKE_STORE_BASE_URL=http://localhost:1

# redis
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_KEY_PREFIX=node-service-template-perf:
REDIS_PASSWORD=sOmE_sEcUrE_pAsS
REDIS_USE_TLS=false
SCHEDULER_REDIS_HOST=localhost
SCHEDULER_REDIS_PORT=6380
SCHEDULER_REDIS_KEY_PREFIX=node-service-template-perf-scheduler:
SCHEDULER_REDIS_PASSWORD=sOmE_sEcUrE_pAsS
SCHEDULER_REDIS_USE_TLS=false

# AMQP
AMQP_HOSTNAME=localhost
AMQP_PORT=5673
AMQP_USERNAME=guest
AMQP_PASSWORD=guest
AMQP_USE_TLS=false

# jobs: far apart, so background work does not land in the middle of a measured run
DELETE_OLD_USERS_JOB_PERIOD_IN_SECS=60000
PROCESS_LOGS_FILES_JOB_PERIOD_IN_SECS=60000
SEND_EMAILS_JOB_CRON="0 0 1 1 *"

# aws (fauxqs)
AWS_REGION=eu-central-1
AWS_ENDPOINT=http://localhost:4568
AWS_SNS_ENDPOINT=http://localhost:4568
AWS_SQS_ENDPOINT=http://localhost:4568
AWS_ACCESS_KEY_ID=dummyId
AWS_SECRET_ACCESS_KEY=dummyKey

# vendors: nothing that would call out of the machine
OTEL_ENABLED=false
BUGSNAG_ENABLED=false
AMPLITUDE_ENABLED=false

# Pyroscope. Off here; `--profiling` turns it on for the run.
PYROSCOPE_ENABLED=false
PYROSCOPE_SERVER_ADDRESS=http://localhost:4041
# Read by the Pyroscope SDK itself. At the 60s default a one-minute run produces a single
# data point and the last window arrives only when the process stops.
PYROSCOPE_FLUSH_INTERVAL_MS=15000
PYROSCOPE_WALL_SAMPLING_DURATION_MS=15000
# Records CPU time alongside wall time: `pyroscope-analyze --type cpu` against the default
# wall profile is what separates "busy" from "waiting".
PYROSCOPE_WALL_COLLECT_CPU_TIME=true
