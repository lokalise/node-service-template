# Test values. Loads on top of .env.shared, from test/envSetupHook.ts.
# Tests never read .env, so local changes can't leak into a test run, and CI and local runs match.
#
# Don't put real credentials here.

NODE_ENV=test
DATABASE_URL=postgresql://serviceuser:pass@localhost:5432/service_db_test

# asserted by the healthcheck tests in src/app.e2e.spec.ts
APP_VERSION=1
GIT_COMMIT_SHA=sha

# vendors: nothing that would call out of the machine. These repeat .env.shared and schema
# defaults on purpose, so enabling a vendor for local dev can't make tests send data.
OTEL_ENABLED=false
BUGSNAG_ENABLED=false
AMPLITUDE_ENABLED=false

# fauxqs is started in-process by test/FauxqsHelper.ts on 4567
AWS_ENDPOINT=http://localhost:4567
